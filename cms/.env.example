# Copy to .env and fill in. Never commit .env.
#
# Only SECRETS and per-deployment identity live here. The security *posture*
# (which routes are closed, MCP off, trusting the proxy's forwarded IP, the
# short session lifetime) is baked into the build — astro.config.mjs,
# src/security/*, providers/discord/src/config.ts — so a VPS cannot ship
# without it by forgetting an env var. See reports/05-security.md.
#
# Secrets should not sit in the process environment on the box either: on a
# real deployment load them from a root-owned file or Docker/systemd secret
# read at boot (out of `docker inspect`, /proc/<pid>/environ and crash dumps),
# and never bake them into the committed build. This file lists them for the
# local sandbox only.

# --- Secrets ---------------------------------------------------------------
# Generate with: pnpm emdash secrets generate
EMDASH_ENCRYPTION_KEY=
# Setup wizard lock (any long random string). Open /_emdash/admin/setup?setup_token=<value>
EMDASH_SETUP_TOKEN=
# Discord application (https://discord.com/developers/applications)
DISCORD_CLIENT_SECRET=
# Optional: a bot in the guild, enables re-checking live sessions
DISCORD_BOT_TOKEN=
# Public-site build trigger (unset = log only)
BUILD_DISPATCH_TOKEN=

# --- Per-deployment identity (not secret, but varies by environment) -------
# Public origin users open (behind a TLS-terminating proxy: the https:// origin)
EMDASH_SITE_URL=http://localhost:4321
# Redirect URI to register: <EMDASH_SITE_URL>/_emdash/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_LEADER_ROLE_IDS=
DISCORD_MEMBER_ROLE_IDS=
BUILD_DISPATCH_URL=

# --- Operational switches ---------------------------------------------------
# Cold-standby sign-in (magic link). "on" only while Discord is unavailable.
EMDASH_COLD_STANDBY=off
# "on" only while onboarding another operator through an invite
EMDASH_ALLOW_INVITES=off

# --- Baked security defaults (override only if you must) --------------------
# These have secure defaults compiled into the build; set them only to relax
# or retarget for a specific deployment.
#   trustedProxyHeaders ["x-forwarded-for"] is set in astro.config.mjs, so the
#   login rate limits (5-5) work without this env var. Override to name a
#   different proxy header. The Node port must be reachable ONLY through the
#   proxy (bind 127.0.0.1 / firewall it), or x-forwarded-for can be spoofed.
# EMDASH_TRUSTED_PROXY_HEADERS=x-real-ip
#   Session lifetime defaults to 1h in providers/discord/src/config.ts (5-6).
# DISCORD_SESSION_MAX_AGE_SECONDS=3600
# DISCORD_REVALIDATE_SECONDS=600
# "off" only if Discord rejects the PKCE parameters
# DISCORD_PKCE=on

# --- Local sandbox only (mock Discord; never set in production) --------------
# DISCORD_API_BASE=http://127.0.0.1:4400/api/v10
# DISCORD_AUTHORIZE_URL=http://127.0.0.1:4400/oauth2/authorize
