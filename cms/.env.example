# Copy to .env and fill in. Never commit .env.

# Public origin users open (behind a TLS-terminating proxy: the https:// origin)
EMDASH_SITE_URL=http://localhost:4321
# Generate with: pnpm emdash secrets generate
EMDASH_ENCRYPTION_KEY=

# Setup wizard lock (any long random string). Open /_emdash/admin/setup?setup_token=<value>
EMDASH_SETUP_TOKEN=

# Discord application (https://discord.com/developers/applications)
# Redirect URI to register: <EMDASH_SITE_URL>/_emdash/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_LEADER_ROLE_IDS=
DISCORD_MEMBER_ROLE_IDS=
# Optional: bot in the guild, enables re-checking live sessions
DISCORD_BOT_TOKEN=
# Session hardening (reports/05-security.md 5-6). A stolen/ hijacked member
# session stays usable only until it expires, and re-login goes back through
# Discord OAuth — which the attacker cannot complete without the Discord
# account. Keep the max age short; re-login is a near-instant redirect while
# the member is still signed in to Discord.
DISCORD_SESSION_MAX_AGE_SECONDS=3600   # 1 hour (was 43200 = 12h by default)
# How often a live session is re-checked against Discord (membership/roles).
DISCORD_REVALIDATE_SECONDS=600

# Local mock instead of discord.com (see providers/discord/README.md)
# DISCORD_API_BASE=http://127.0.0.1:4400/api/v10
# DISCORD_AUTHORIZE_URL=http://127.0.0.1:4400/oauth2/authorize
# "off" only if Discord rejects the PKCE parameters
# DISCORD_PKCE=on

# Cold-standby sign-in (magic link). "on" only while Discord is unavailable.
# Behind a reverse proxy (nginx/Caddy): REQUIRED, or the login rate limits do
# nothing (reports/05-security.md 5-5). Name the header your proxy sets.
EMDASH_TRUSTED_PROXY_HEADERS=x-forwarded-for

EMDASH_COLD_STANDBY=off
# "on" only while onboarding another operator through an invite
EMDASH_ALLOW_INVITES=off

# Public-site build trigger (unset = log only)
BUILD_DISPATCH_URL=
BUILD_DISPATCH_TOKEN=
